@prefix lm: <https://www.legendmod.ml/knowledge/vocabulary.ttl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
lm:GameMechanic a rdfs:Class ; rdfs:subClassOf schema:DefinedTerm ; rdfs:label "Game mechanic"@en ; rdfs:comment "A documented rule or behavior of a game."@en .
lm:GameMode a rdfs:Class ; rdfs:subClassOf schema:DefinedTerm ; rdfs:label "Game mode"@en ; rdfs:comment "A supported style of gameplay."@en .
lm:Feature a rdfs:Class ; rdfs:subClassOf schema:DefinedTerm ; rdfs:label "Feature"@en ; rdfs:comment "A documented feature of a software application."@en .
lm:hasMechanic a rdf:Property ; rdfs:domain schema:VideoGame ; rdfs:range lm:GameMechanic ; rdfs:label "has mechanic"@en .
lm:hasGameMode a rdf:Property ; rdfs:domain schema:VideoGame ; rdfs:range lm:GameMode ; rdfs:label "has game mode"@en .
lm:hasFeature a rdf:Property ; rdfs:domain schema:SoftwareApplication ; rdfs:range lm:Feature ; rdfs:label "has feature"@en .
