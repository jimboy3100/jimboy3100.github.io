    {
      "@id": "https://www.legendmod.ml/#extension",
      "@type": "SoftwareApplication",
      "name": "Legend Express",
      "description": "Chrome extension for Legend Mod. Adds custom skins, themes, controls and more to Agar.io-style games. Does NOT collect, store or transmit personal data externally.",
      "applicationCategory": "BrowserExtension",
      "operatingSystem": "Chrome",
      "softwareVersion": "1.8.4",
