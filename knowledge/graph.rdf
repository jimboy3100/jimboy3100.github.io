    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-coordinate-scrambling"/>
    <lm:hasGameMode rdf:resource="https://help.expanding.land/knowledge/#mode-ffa"/>
    <lm:hasGameMode rdf:resource="https://help.expanding.land/knowledge/#mode-teams"/>
  </rdf:Description>
