    <schema:description>Android app for Expanding Land. PWA with fullscreen landscape play.</schema:description>
    <schema:applicationCategory>GameApplication</schema:applicationCategory>
    <schema:operatingSystem>Android</schema:operatingSystem>
    <schema:isPartOf rdf:resource="https://expanding.land/#game"/>
  </rdf:Description>
