  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-controls">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Configurable controls and hotkeys</schema:name>
    <schema:description>Fully rebindable keyboard, mouse and gamepad controls with Command Centre search.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-skins">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Custom skins, video skins and skin tools</schema:name>
    <schema:description>Custom image URLs, video skins, skin collections, skin checker, IndexedDB cache.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-themes">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Themes and HUD customization</schema:name>
    <schema:description>CSS variable-based themes, 8 presets, Theme Workshop with live preview.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-commandcentre">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Command Centre</schema:name>
    <schema:description>Fuzzy-search palette (Ctrl+K) for every setting, hotkey, theme and window.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-multibox">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Multibox controls</schema:name>
    <schema:description>Control up to 4 connections with colour-coded rings and middle camera view.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-replays">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Replay tools</schema:name>
    <schema:description>Packet recording, instant replay, Replay Studio, match history, personal bests.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-gamepad">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Gamepad support</schema:name>
    <schema:description>Full controller support with customizable mapping, dead zone, response curve and vibration.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-performance">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Performance diagnostics</schema:name>
    <schema:description>WebGL2 acceleration, adaptive performance, FPS cap, diagnostics window.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-companion">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Second-screen companion</schema:name>
    <schema:description>Broadcast live game state to a second window via BroadcastChannel.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/knowledge/#feature-accessibility">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#Feature"/>
    <schema:name>Accessibility features</schema:name>
    <schema:description>Reduced motion, text scale, HUD text scale, opponent indicators, colour-blind preset.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-dynamic-map">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Dynamic circular arena</schema:name>
    <schema:description>Server-controlled circular boundary that expands and contracts (0.25x to 8x).</schema:description>
    <schema:url rdf:resource="https://help.expanding.land/dynamic-map.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-cell-growth">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Cell growth</schema:name>
    <schema:description>Collect food pellets and consume smaller cells to grow.</schema:description>
    <schema:url rdf:resource="https://help.expanding.land/guide.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-split">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Splitting</schema:name>
    <schema:description>Divide cell into two halves (Space key), up to 16 fragments.</schema:description>
    <schema:url rdf:resource="https://help.expanding.land/guide.html#splitting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-mass">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Mass ejection</schema:name>
    <schema:description>Eject mass toward cursor (W key), costs ~15-16 mass per press.</schema:description>
    <schema:url rdf:resource="https://help.expanding.land/guide.html#mass"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-decay">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Mass decay</schema:name>
    <schema:description>Cells lose approximately 0.8% of mass every 4 seconds.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-virus">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Viruses</schema:name>
    <schema:description>Spiky green circles that pop big cells into ~16 pieces. Feed 7 W-presses to shoot.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-merge">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Merge timer</schema:name>
    <schema:description>Split cells rejoin after a timer based on mass.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-ghost-cells">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Ghost cells</schema:name>
    <schema:description>Transparent cells showing death location (Expanding Land exclusive).</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-bots">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Server-controlled bots</schema:name>
    <schema:description>Human and server-controlled bot populations vary by arena.</schema:description>
    <schema:url rdf:resource="https://help.expanding.land/no-bots.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-spectate">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Spectator mode</schema:name>
    <schema:description>200+ spectator slots with free-roam camera.</schema:description>
    <schema:url rdf:resource="https://help.expanding.land/glossary.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-anti-teaming">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Anti-teaming system</schema:name>
    <schema:description>Exponential multiplier decay: base × pow(1.086, multiplier).</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mechanic-coordinate-scrambling">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMechanic"/>
    <schema:name>Coordinate scrambling</schema:name>
    <schema:description>Anti-cheat: each player receives different coordinate offsets.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mode-ffa">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMode"/>
    <schema:name>Free-for-all</schema:name>
    <schema:description>Competitive individual play.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://help.expanding.land/knowledge/#mode-teams">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <rdf:type rdf:resource="https://www.legendmod.ml/knowledge/vocabulary.ttl#GameMode"/>
    <schema:name>Teams</schema:name>
    <schema:description>Team-based play on supported arenas.</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.legendmod.ml/#faq">
    <rdf:type rdf:resource="https://schema.org/FAQPage"/>
    <schema:name>Legend Mod and Expanding Land FAQ</schema:name>
    <schema:mainEntity rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Question"/>
      <schema:name>Is Expanding Land the official Agar.io service?</schema:name>
      <schema:acceptedAnswer rdf:parseType="Resource">
        <rdf:type rdf:resource="https://schema.org/Answer"/>
        <schema:text>No. Expanding Land is an independent multiplayer cell game built from scratch in C.</schema:text>
      </schema:acceptedAnswer>
    </schema:mainEntity>
    <schema:mainEntity rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Question"/>
      <schema:name>Does the map change?</schema:name>
      <schema:acceptedAnswer rdf:parseType="Resource">
        <rdf:type rdf:resource="https://schema.org/Answer"/>
        <schema:text>Yes. The server controls expansion and contraction of the circular arena (0.25x to 8x).</schema:text>
      </schema:acceptedAnswer>
    </schema:mainEntity>
    <schema:mainEntity rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Question"/>
      <schema:name>Are all opponents human?</schema:name>
      <schema:acceptedAnswer rdf:parseType="Resource">
        <rdf:type rdf:resource="https://schema.org/Answer"/>
        <schema:text>Not necessarily. Human and server-controlled bot counts vary by arena.</schema:text>
      </schema:acceptedAnswer>
    </schema:mainEntity>
    <schema:mainEntity rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Question"/>
      <schema:name>What is Legend Mod?</schema:name>
      <schema:acceptedAnswer rdf:parseType="Resource">
        <rdf:type rdf:resource="https://schema.org/Answer"/>
        <schema:text>A browser client and Chrome extension that adds custom skins, themes, controls, multiboxing and replays to Agar.io-style cell games.</schema:text>
      </schema:acceptedAnswer>
    </schema:mainEntity>
    <schema:mainEntity rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Question"/>
      <schema:name>Is Legend Mod free?</schema:name>
      <schema:acceptedAnswer rdf:parseType="Resource">
        <rdf:type rdf:resource="https://schema.org/Answer"/>
        <schema:text>Yes. Legend Mod and Expanding Land are free to use with no subscription required.</schema:text>
      </schema:acceptedAnswer>
    </schema:mainEntity>
  </rdf:Description>
