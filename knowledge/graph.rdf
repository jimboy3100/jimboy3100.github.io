  <rdf:Description rdf:about="https://www.legendmod.ml/#app">
    <rdf:type rdf:resource="https://schema.org/SoftwareApplication"/>
    <rdf:type rdf:resource="https://schema.org/WebApplication"/>
    <schema:name>Legend Mod</schema:name>
    <schema:url rdf:resource="https://www.legendmod.ml/"/>
    <schema:description>Legend Mod is a browser client and extension project for Agar.io-style cell games, with custom skins, themes, configurable controls, multiboxing and replay tools.</schema:description>
    <schema:applicationCategory>GameApplication</schema:applicationCategory>
    <schema:operatingSystem>Web browser</schema:operatingSystem>
    <schema:softwareVersion>3.629</schema:softwareVersion>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:inLanguage>ar</schema:inLanguage>
    <schema:inLanguage>bg</schema:inLanguage>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:inLanguage>el</schema:inLanguage>
    <schema:inLanguage>es</schema:inLanguage>
    <schema:inLanguage>fr</schema:inLanguage>
    <schema:inLanguage>id</schema:inLanguage>
    <schema:inLanguage>it</schema:inLanguage>
    <schema:inLanguage>ja</schema:inLanguage>
    <schema:inLanguage>nl</schema:inLanguage>
    <schema:inLanguage>pl</schema:inLanguage>
    <schema:inLanguage>pt</schema:inLanguage>
    <schema:inLanguage>ru</schema:inLanguage>
    <schema:inLanguage>tr</schema:inLanguage>
    <schema:inLanguage>zh</schema:inLanguage>
    <schema:featureList>Custom skins</schema:featureList>
    <schema:featureList>Video skins</schema:featureList>
    <schema:featureList>Themes</schema:featureList>
    <schema:featureList>Configurable controls</schema:featureList>
    <schema:featureList>Command Centre</schema:featureList>
    <schema:featureList>Multiboxing</schema:featureList>
    <schema:featureList>Replay tools</schema:featureList>
    <schema:featureList>Gamepad support</schema:featureList>
    <schema:featureList>Mobile touch controls</schema:featureList>
    <schema:featureList>Settings profiles</schema:featureList>
    <schema:featureList>Performance diagnostics</schema:featureList>
    <schema:featureList>Adaptive performance</schema:featureList>
    <schema:featureList>Second-screen companion</schema:featureList>
    <schema:featureList>Chat system</schema:featureList>
    <schema:featureList>HUD helpers</schema:featureList>
    <schema:featureList>Accessibility features</schema:featureList>
    <schema:featureList>Streamer mode</schema:featureList>
    <schema:offers rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Offer"/>
      <schema:price>0</schema:price>
      <schema:priceCurrency>USD</schema:priceCurrency>
    </schema:offers>
    <schema:isRelatedTo rdf:resource="https://expanding.land/#game"/>
