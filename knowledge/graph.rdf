  <rdf:Description rdf:about="https://www.legendmod.ml/#extension">
    <rdf:type rdf:resource="https://schema.org/SoftwareApplication"/>
    <schema:name>Legend Express</schema:name>
    <schema:description>Chrome extension for Legend Mod. Adds custom skins, themes, controls and more to Agar.io-style games. Does NOT collect, store or transmit personal data externally.</schema:description>
    <schema:applicationCategory>BrowserExtension</schema:applicationCategory>
    <schema:operatingSystem>Chrome</schema:operatingSystem>
    <schema:softwareVersion>1.8.4</schema:softwareVersion>
    <schema:installUrl rdf:resource="https://chromewebstore.google.com/detail/legend-express-agario-ext/nmkhchnpjlcnicfchpkhckidmmmondja"/>
    <schema:browserRequirements>Google Chrome</schema:browserRequirements>
    <schema:offers rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Offer"/>
      <schema:price>0</schema:price>
      <schema:priceCurrency>USD</schema:priceCurrency>
    </schema:offers>
    <schema:isPartOf rdf:resource="https://www.legendmod.ml/#app"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://expanding.land/#game">
    <rdf:type rdf:resource="https://schema.org/VideoGame"/>
    <rdf:type rdf:resource="https://schema.org/WebApplication"/>
    <schema:name>Expanding Land</schema:name>
    <schema:url rdf:resource="https://expanding.land/"/>
    <schema:description>Expanding Land is a free multiplayer browser cell game with a dynamic circular arena that expands and contracts, FFA and Teams modes, and a C-based server. Human and server-controlled bot populations vary by arena.</schema:description>
    <schema:genre>Multiplayer cell game</schema:genre>
    <schema:genre>IO game</schema:genre>
    <schema:gamePlatform>Web browser</schema:gamePlatform>
    <schema:operatingSystem>Web browser</schema:operatingSystem>
    <schema:applicationCategory>GameApplication</schema:applicationCategory>
    <schema:numberOfPlayers rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/QuantitativeValue"/>
      <schema:maxValue>3840</schema:maxValue>
    </schema:numberOfPlayers>
    <schema:featureList>Dynamic circular map</schema:featureList>
    <schema:featureList>FFA and Teams modes</schema:featureList>
    <schema:featureList>Spectator mode</schema:featureList>
    <schema:featureList>Anti-teaming system</schema:featureList>
    <schema:featureList>Anti-cheat</schema:featureList>
    <schema:featureList>Ghost cells</schema:featureList>
    <schema:featureList>Session stats</schema:featureList>
    <schema:featureList>In-game chat</schema:featureList>
    <schema:featureList>Encrypted connections</schema:featureList>
    <schema:playMode>MultiPlayer</schema:playMode>
    <schema:offers rdf:parseType="Resource">
      <rdf:type rdf:resource="https://schema.org/Offer"/>
      <schema:price>0</schema:price>
      <schema:priceCurrency>USD</schema:priceCurrency>
    </schema:offers>
    <schema:isRelatedTo rdf:resource="https://www.legendmod.ml/#app"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-dynamic-map"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-cell-growth"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-split"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-mass"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-decay"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-virus"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-merge"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-ghost-cells"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-bots"/>
    <lm:hasMechanic rdf:resource="https://help.expanding.land/knowledge/#mechanic-spectate"/>
